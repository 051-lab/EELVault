{
  "name": "ANIMA",
  "displayName": "ANIMA — Vintage Harmonic Engine",
  "version": "1.0.2",
  "status": "definitive",
  "type": "fixed-parameter-analog-emulation",
  "target": [
    "rootless-jamesdsp",
    "jdsp4linux"
  ],
  "file": "anima.eel",
  "versions": {
    "v0.1.0": "versions/v0.1.0-base-analog-chain.eel",
    "v0.2.0": "versions/v0.2.0-auto-makeup-gain.eel",
    "v0.3.0": "versions/v0.3.0-hermite-interpolation.eel",
    "v0.4.0": "versions/v0.4.0-thermal-hysteresis.eel",
    "v0.5.0": "versions/v0.5.0-isp-estimation.eel",
    "v1.0.0": "versions/v1.0.0-denormal-protection.eel",
    "v1.0.1": "versions/v1.0.1-corrective-release.eel",
    "v1.0.2": "versions/v1.0.2-mobile-optimization.eel"
  },
  "parameters": {
    "highPassHz": 30,
    "shelfHz": 120,
    "shelfDb": 1.5,
    "driveDb": 4.0,
    "warmth": 0.12,
    "tapeLpHz": 14000,
    "tapeAmt": 0.45,
    "tiltHz": 1000,
    "tiltDepth": 0.06,
    "baseDelayMs": 2.0,
    "flutterMs": 0.35,
    "sideDb": 0.7,
    "autoBaseDb": 2.4,
    "autoMakeupMaxDb": 3.0,
    "relFastSec": 0.150,
    "relSlowSec": 0.600,
    "histTimeSec": 0.200,
    "ispCoeff": 0.25,
    "dcBlockHz": 5,
    "outDb": -0.6,
    "ceilDb": -0.3
  },
  "features": [
    "even-harmonic-saturation",
    "tape-damping",
    "program-dependent-compression",
    "thermal-hysteresis",
    "auto-makeup-gain",
    "dynamic-tilt-eq",
    "micro-flutter",
    "hermite-interpolation",
    "mid-side-width",
    "isp-estimation",
    "denormal-protection",
    "safety-limiter",
    "program-dependent-release",
    "non-finite-input-protection",
    "quadrature-lfo-oscillator",
    "quadrature-renormalization"
  ],
  "hasUserControls": false,
  "latencyMs": 2.0,
  "created": "2025-01-01",

desc: ANIMA - Vintage Harmonic Engine (Base Analog Chain)

[init](init)
// ============================================================
// FIXED DEFINITIVE PARAMETERS
// ============================================================

DB_TO_LIN = 0.11512925464970228;

hpHz = 30;
shelfHz = 120;
shelfDb = 1.5;

driveDb = 4.0;
warmth = 0.12;

tapeLpHz = 14000;
tapeAmt = 0.45;

tiltHz = 1000;
tiltDepth = 0.06;

baseDelayMs = 2.0;
flutterMs = 0.35;

sideDb = 0.7;
outDb = -0.6;
ceilDb = -0.3;

// ============================================================
// COEFFICIENTS
// ============================================================

hpCoeff = 1 - exp(-2 * $pi * hpHz / srate);
shelfCoeff = 1 - exp(-2 * $pi * shelfHz / srate);
tapeLpCoeff = 1 - exp(-2 * $pi * tapeLpHz / srate);
tiltCoeff = 1 - exp(-2 * $pi * tiltHz / srate);

driveLin = exp(driveDb * DB_TO_LIN);
shelfGain = exp(shelfDb * DB_TO_LIN) - 1;
sideGain = exp(sideDb * DB_TO_LIN);
outGain = exp(outDb * DB_TO_LIN);
ceilLin = exp(ceilDb * DB_TO_LIN);

makeupGain = exp(2.4 * DB_TO_LIN);

rel = exp(-1 / (0.30 * srate));

limRel = exp(-1 / (0.080 * srate));

// ============================================================
// DELAY MEMORY
// ============================================================

DELAY_SIZE = 4096;
DELAY_MASK = DELAY_SIZE - 1;

dL = 0;
dR = DELAY_SIZE;

i = 0;
loop(DELAY_SIZE * 2,
    dL[i] = 0;
    i += 1;
);

wpos = 0;

baseDelay = baseDelayMs * 0.001 * srate;
flutterDepth = flutterMs * 0.001 * srate;

baseDelay = min(baseDelay, 1600);
flutterDepth = min(flutterDepth, 160);

lfo1 = 0;
lfo2 = 1.3;

// ============================================================
// STATE VARIABLES
// ============================================================

hpL = 0; hpR = 0;
shelfL = 0; shelfR = 0;
tapeL = 0; tapeR = 0;
tiltL = 0; tiltR = 0;
dcL = 0; dcR = 0;
env = 0;
limGain = 1;

[slider](slider)
0;

[block](block)
0;

[sample](sample)
inL = spl0;
inR = spl1;

// 1. 30 Hz HIGH-PASS
hpL += hpCoeff * (inL - hpL);
xL = inL - hpL;
hpR += hpCoeff * (inR - hpR);
xR = inR - hpR;

// 2. TRANSFORMER WEIGHT
shelfL += shelfCoeff * (xL - shelfL);
xL += shelfGain * shelfL;
shelfR += shelfCoeff * (xR - shelfR);
xR += shelfGain * shelfR;

// 3. EVEN-HARMONIC SATURATION
preL = xL * driveLin;
preR = xR * driveLin;

oddL = preL / (1 + abs(preL));
oddR = preR / (1 + abs(preR));

evenL = oddL * oddL * 2;
evenR = oddR * oddR * 2;

satL = (oddL + warmth * (evenL - oddL)) / driveLin;
satR = (oddR + warmth * (evenR - oddR)) / driveLin;

// 4. TAPE DAMPING
tapeL += tapeLpCoeff * (satL - tapeL);
tapeR += tapeLpCoeff * (satR - tapeR);
satL = tapeL;
satR = tapeR;

// 5. LINKED TAPE COMPRESSION
peak = max(abs(satL), abs(satR));
env = peak > env ? peak : env * rel;
tapeGain = 1 / (1 + tapeAmt * env);
satL *= tapeGain;
satR *= tapeGain;

// 6. DYNAMIC TILT EQ
tiltL += tiltCoeff * (satL - tiltL);
lowL = tiltL;
highL = satL - lowL;
tiltR += tiltCoeff * (satR - tiltR);
lowR = tiltR;
highR = satR - lowR;

tiltAmt = tiltDepth * env;
satL = lowL * (1 + tiltAmt) + highL * (1 - 0.75 * tiltAmt);
satR = lowR * (1 + tiltAmt) + highR * (1 - 0.75 * tiltAmt);

// 7. DC REMOVAL
dcL += hpCoeff * (satL - dcL);
satL -= dcL;
dcR += hpCoeff * (satR - dcR);
satR -= dcR;

// 8. MICRO-FLUTTER
lfo1 += 2 * $pi * 0.15 / srate;
lfo1 >= 2 * $pi ? ( lfo1 -= 2 * $pi );
lfo2 += 2 * $pi * 0.23 / srate;
lfo2 >= 2 * $pi ? ( lfo2 -= 2 * $pi );

mod = flutterDepth * (0.65 * sin(lfo1) + 0.35 * sin(lfo2 * 1.7 + 1.3));
del = baseDelay + mod;
del = max(4, min(DELAY_MASK - 2, del));

dL[wpos] = satL;
dR[wpos] = satR;

rp = wpos - del;
rp < 0 ? ( rp += DELAY_SIZE );

// 8.5 LINEAR INTERPOLATION
i0 = rp | 0;
frac = rp - i0;
i1 = (i0 + 1) & DELAY_MASK;

wetL = dL[i0] * (1 - frac) + dL[i1] * frac;
wetR = dR[i0] * (1 - frac) + dR[i1] * frac;

wpos = (wpos + 1) & DELAY_MASK;

// 9. MID/SIDE WIDTH LIFT
mid = (wetL + wetR) * 0.5;
side = (wetL - wetR) * 0.5 * sideGain;
outL = mid + side;
outR = mid - side;

// 9.5 FIXED MAKEUP GAIN STAGE
outL *= makeupGain;
outR *= makeupGain;

// 10. OUTPUT TRIM
outL *= outGain;
outR *= outGain;

// 10.5 SAFETY LIMITER
pk = max(abs(outL), abs(outR));

limTarget = pk > ceilLin ? ceilLin / pk : 1.0;
limGain = limTarget < limGain ? limTarget : limGain * limRel + limTarget * (1 - limRel);

outL *= limGain;
outR *= limGain;

outL = max(min(outL, ceilLin), -ceilLin);
outR = max(min(outR, ceilLin), -ceilLin);

spl0 = outL;
spl1 = outR;